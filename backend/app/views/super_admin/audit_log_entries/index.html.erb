<% content_for :page_title, "Audit Log" %>

<%= render "shared/page_header", icon: "bx-history", crumbs: [ { label: "Audit Log" } ] %>

<div class="mb-3">
  <%= form_with url: platform_audit_log_entries_path, method: :get, local: true, class: "row g-2 align-items-center" do %>
    <div class="col-auto">
      <%= select_tag :actor_id,
            options_for_select([ [ "All actors", "" ] ] + @actors.map { |actor| [ actor.email, actor.id ] }, @actor_filter),
            class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= select_tag :action_name,
            options_for_select([ [ "All actions", "" ] ] + @actions.map { |action| [ action, action ] }, @action_filter),
            class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= select_tag :target_type,
            options_for_select([ [ "All target types", "" ] ] + @target_types.map { |type| [ type, type ] }, @target_type_filter),
            class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= date_field_tag :from_date, @from_date, class: "form-control", placeholder: "From" %>
    </div>
    <div class="col-auto">
      <%= date_field_tag :to_date, @to_date, class: "form-control", placeholder: "To" %>
    </div>
    <div class="col-auto">
      <%= submit_tag "Filter", class: "btn btn-m btn-outline-secondary" %>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-body">
    <% if @entries.none? %>
      <%= render "shared/empty_state", icon: "bx-history", message: "No matching audit log entries." %>
    <% else %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>When</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Target</th>
              <th class="text-end">Details</th>
            </tr>
          </thead>
          <tbody>
            <% @entries.each do |entry| %>
              <tr>
                <td class="text-nowrap"><%= entry.created_at.to_fs(:long) %></td>
                <td><%= entry.actor.email %></td>
                <td><code><%= entry.action %></code></td>
                <td>
                  <% if entry.target.present? %>
                    <%= entry.target_type %> <span class="text-muted">(<%= entry.target_id[0..7] %>…)</span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <button type="button" class="btn btn-m btn-outline-secondary" title="View Details"
                          data-bs-toggle="modal" data-bs-target="#audit-entry-modal-<%= entry.id %>">
                    <i class="bx bx-detail"></i>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="d-flex justify-content-center mt-3">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>

      <%# shared/_console_shell.html.erb's own `yield :modals` — same reasoning as
          agency_console/events/show.html.erb's own Badges preview modal (that comment has the
          full "why": a plain page-body modal renders off-screen the moment the page was scrolled
          while impersonating, since `body.impersonating #layout-wrapper`'s transform makes it the
          containing block for the modal's own `position: fixed`). One modal per row, same
          "static pre-built markup, no click-time JS" shape admin/badges/_badges_table.html.erb's
          own preview modal already takes — this table only ever shows a page's worth (25) of
          entries at a time. %>
      <% content_for :modals do %>
        <% @entries.each do |entry| %>
          <div class="modal fade" id="audit-entry-modal-<%= entry.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                  <h5 class="modal-title fw-semibold"><code><%= entry.action %></code></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                  <dl class="row mb-0">
                    <dt class="col-sm-3">When</dt>
                    <dd class="col-sm-9"><%= entry.created_at.to_fs(:long) %></dd>

                    <dt class="col-sm-3">Actor</dt>
                    <dd class="col-sm-9"><%= entry.actor.email %></dd>

                    <dt class="col-sm-3">Action</dt>
                    <dd class="col-sm-9"><code><%= entry.action %></code></dd>

                    <dt class="col-sm-3">Target</dt>
                    <dd class="col-sm-9 <%= "mb-0" if entry.metadata.blank? %>">
                      <% if entry.target.present? %>
                        <%= entry.target_type %> <span class="text-muted"><%= entry.target_id %></span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </dd>

                    <% if entry.metadata.present? %>
                      <dt class="col-sm-3">Metadata</dt>
                      <dd class="col-sm-9 mb-0">
                        <pre class="bg-light border rounded p-2 mb-0 font-size-13"><code><%= JSON.pretty_generate(entry.metadata) %></code></pre>
                      </dd>
                    <% end %>
                  </dl>
                </div>
                <div class="modal-footer border-0 pt-3">
                  <button type="button" class="btn btn-secondary btn-m" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
