<% content_for :page_title, "#{@account.name} — Events" %>

<%# doc/event_page_templates_plan.md, Stage 2 — read-only drill-down. "View" reaches this event's
    own read-only details (#show), which is in turn where the Event Page screen (Stage 3) is
    reached from now — this index row no longer links there directly. Everything else about event
    management (creating/editing an event, participants, tickets, ...) still happens on the
    tenant's own Admin Console, reached via the "Switch to this tenant" action on
    agency/accounts#index. %>
<%= render layout: "shared/page_header", locals: { icon: "bx-calendar-event",
  crumbs: [ { label: "Clients", path: agency_accounts_path }, { label: @account.name } ] } do %>
<% end %>

<div class="card">
  <div class="card-body">
    <% if @events.none? %>
      <%= render "shared/empty_state", icon: "bx-calendar-event", message: "#{@account.name} has no events yet." %>
    <% else %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Event</th>
              <th>Dates</th>
              <%# requirement.md revisit: "client also create event but event created by client
                  requires a agency approval" — a Pending/Rejected badge here is what lets an
                  agency spot its own review queue across every one of a client's events without
                  opening each row's own #show page; blank for the common not_required/approved
                  case, same "don't clutter the good state" reasoning agency_console/events/
                  show.html.erb's own badge row already follows. %>
              <th>Approval</th>
              <th>Event Page</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <tr>
                <td><%= event.name %></td>
                <td><%= event.starts_at&.to_fs(:long) %></td>
                <td>
                  <% if event.approval_pending? %>
                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                  <% elsif event.approval_rejected? %>
                    <span class="badge bg-danger-subtle text-danger">Rejected</span>
                  <% end %>
                </td>
                <td>
                  <% if event.event_page&.template_key.present? %>
                    <span class="badge bg-primary"><%= event.event_page.template_key.humanize %></span>
                  <% elsif event.event_page.present? %>
                    <span class="badge bg-secondary">Custom HTML</span>
                  <% else %>
                    <span class="badge bg-light text-dark">Not set</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to "View", agency_account_event_path(@account, event),
                        class: "btn btn-m btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
