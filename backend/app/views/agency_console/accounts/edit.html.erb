  icon: "bx-buildings",
  crumbs: [ { label: Current.agency.name, path: agency_root_path },
            { label: "Clients", path: agency_accounts_path },
            { label: "Edit #{@account.name}" } ] %>

<div class="row">
  <div class="col-xl-7 col-lg-9">
    <div class="card">
      <div class="card-body">
        <%= render "form", account: @account %>
      </div>
    </div>
  </div>
</div>
