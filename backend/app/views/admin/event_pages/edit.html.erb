<% content_for :page_title, "Event Page" %>

<%= render "shared/page_header",
  icon: "bx-globe",
  crumbs: [ { label: "Events", path: admin_events_path }, { label: @event.name, path: admin_event_path(@event) },
            { label: "Event Page" } ] %>

<%# Phase 25.5 — Public Event Site (doc/public_event_site_options.md). Two columns: the raw-HTML
    textarea on the left, a live preview iframe on the right — driven by event_page_preview_controller.js,
    which drops the *current* (unsaved) textarea contents straight into the iframe via `srcdoc`. No
    server round-trip, unlike Email Templates' own preview — there's no token substitution to run
    here, this is stored/rendered exactly as written (Confirmed decision #2, doc/
    public_event_site_options.md: deliberately no sanitization — this event's own admin owns the
    risk for their own public page). %>
<div class="row g-3" data-controller="event-page-preview">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-body">
        <%= form_with model: @event_page, url: admin_event_event_page_path(@event), method: :patch do |f| %>
          <div class="mb-3">
            <%= f.label :html, "Page HTML", class: "form-label" %>
            <%= f.text_area :html, rows: 24, class: "#{field_error_class(@event_page, :html)} font-monospace", style: "font-size: 13px;",
                  data: { event_page_preview_target: "html", action: "input->event-page-preview#scheduleRefresh" } %>
            <%= field_error_feedback(@event_page, :html) %>
            <div class="form-text">
              Paste this event's full public page markup. Rendered exactly as written — no
              placeholders, no processing. Saving takes effect immediately; leave blank to fall back
              to the public site's own default page.
            </div>
          </div>

          <div class="d-flex align-items-center gap-3">
            <%= link_to "Cancel", admin_event_path(@event), class: "btn btn-m btn-outline-secondary" %>
            <%= f.submit "Save Event Page", class: "btn btn-m btn-primary ms-auto" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span class="fw-semibold">Preview</span>
        <button type="button" class="btn btn-m btn-outline-primary" data-action="event-page-preview#refresh">
          <i class="bx bx-refresh"></i> Refresh Preview
        </button>
      </div>
      <div class="card-body p-0">
        <iframe data-event-page-preview-target="frame" title="Event page preview"
                style="width: 100%; height: 620px; border: 0;"></iframe>
      </div>
    </div>
  </div>
</div>
